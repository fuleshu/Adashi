{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adashi",
  "version": "../package.json",
  "identifier": "dev.adashi.dashboard",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Adashi",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
