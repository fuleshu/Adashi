{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build:frontend:linux",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build/linux/frontend"
  },
  "bundle": {
    "targets": ["deb"],
    "icon": [
      "icons/linux/32x32.png",
      "icons/linux/128x128.png",
      "icons/linux/128x128@2x.png"
    ]
  }
}
